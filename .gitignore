# Render artifacts from the narrative story engine (frames, intermediate audio).
# Regenerated by pipeline/narrative/build.py — never committed.
pipeline/narrative/build/

# Weekly reel render scratch (regenerated by run_week.sh) — never committed.
pipeline/out/
pipeline/lm*.wav
pipeline/list_*.txt
pipeline/tmp_*/
__pycache__/

# Agent reports live in the private repo valentinavram626-cmd/ola-ops-reports.
# This repository is public so Metricool can fetch the post images from its
# raw URLs; nothing about the day's operations belongs here.
departments/

# Per-topic render scratch: regenerated by build.py for whichever topic is
# building, so its contents are meaningless between runs. The frames that ship
# are committed under posts/carousel/.
pipeline/carousel/*-out/
pipeline/carousel/built-*.html
pipeline/carousel/*.json
